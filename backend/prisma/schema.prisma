generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanKey {
  FREE
  PRO
}

/// SUPERADMIN is the platform operator (sees/edits every account); USER is
/// an artist. Deliberately just two values — there is no per-presskit
/// collaborator model yet, so finer roles would be speculation.
enum UserRole {
  USER
  SUPERADMIN
}

/// What kind of customer the account is. ARTIST owns one page; AGENCY
/// (produtora / selo / agência) owns its own page plus a roster of artist
/// pages, capped by the seats of its subscription.
enum AccountType {
  ARTIST
  AGENCY
}

enum PresskitKind {
  ARTIST
  AGENCY
}

enum ArtistCategory {
  MUSICO_BANDA
  DJ
  ATOR
  ARTISTA_VISUAL
  PRODUTORA
}

enum SectionType {
  BIO
  MUSIC
  VIDEO
  GALLERY
  PRESS
  TOUR_DATES
  CONTACT
  TECH_RIDER
  CUSTOM
  STATS
  TESTIMONIALS
  FAQ
  DOWNLOADS
  ROSTER
}

enum MediaProvider {
  SPOTIFY
  YOUTUBE
  SOUNDCLOUD
  VIMEO
}

enum BillingCycle {
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

/// Mirrors Mercado Pago's preapproval statuses (pending / authorized /
/// paused / cancelled). Delinquency is NOT a status here — it's the
/// `pastDue` flag on an AUTHORIZED subscription, because MP keeps the
/// subscription authorized while it retries a failed charge.
enum SubscriptionStatus {
  PENDING
  AUTHORIZED
  PAUSED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  IN_PROCESS
  APPROVED
  REJECTED
  REFUNDED
  CHARGED_BACK
  CANCELLED
}

enum FeedbackType {
  BUG
  SUGESTAO
  ELOGIO
  DUVIDA
  OUTRO
}

enum FeedbackStatus {
  NOVO
  EM_ANALISE
  RESOLVIDO
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  /// Null for accounts created through "Continuar com Google" that never
  /// set a password; login by password is then refused, not crashed.
  passwordHash String?
  /// Google's stable account id (the ID token's `sub`), set on the first
  /// Google sign-in and used to find the account on later ones.
  googleId  String?  @unique
  name      String
  /// Entitlement, derived from the active subscription by
  /// billing.service syncEntitlement — billing code never edits it any
  /// other way (a superadmin may still override manually).
  planKey   PlanKey  @default(FREE)
  role      UserRole @default(USER)
  accountType AccountType @default(ARTIST)
  /// Artist pages an AGENCY may create, derived from its subscription by
  /// syncEntitlement (trial grants AGENCY_TRIAL_SEATS on top, in memory).
  artistSeats Int @default(0)
  lastLoginAt DateTime?
  /// End of the free PRO trial. New accounts get now() + 14 days from the
  /// database default; accounts that existed before the trial launched stay
  /// null. While it is in the future a FREE user is treated as PRO (see
  /// middlewares/authenticate.ts) — planKey itself is never touched.
  trialEndsAt DateTime? @default(dbgenerated("(now() + '14 days'::interval)"))

  presskits     Presskit[]
  refreshTokens RefreshToken[]
  subscriptions Subscription[]
  payments      Payment[]
  feedbacks     Feedback[]
  passwordResetCodes PasswordResetCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One row per Mercado Pago preapproval. A user may accumulate several
/// over time (cancel → resubscribe); at most one is AUTHORIZED/PENDING.
model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cycle       BillingCycle
  /// Artist pages included (AGENCY plans); 1 for artist plans.
  seats       Int                @default(1)
  status      SubscriptionStatus @default(PENDING)
  amountCents Int
  currency    String             @default("BRL")

  mpPreapprovalId String? @unique
  mpPayerId       String?
  mpInitPoint     String?
  /// MP's own status string, kept verbatim for debugging mismatches.
  mpRawStatus     String?

  nextPaymentDate  DateTime?
  currentPeriodEnd DateTime?
  lastChargedAt    DateTime?
  /// Consecutive failed/retrying charges reported by MP; reset on an
  /// approved payment. Drives the "inadimplência" view.
  failedCharges Int     @default(0)
  pastDue       Boolean @default(false)
  cancelledAt   DateTime?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, pastDue])
}

model Payment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  mpPaymentId           String  @unique
  mpAuthorizedPaymentId String?

  status        PaymentStatus
  statusDetail  String?
  amountCents   Int
  currency      String  @default("BRL")
  paymentMethod String?
  paidAt        DateTime?
  payload       Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, createdAt])
  @@index([subscriptionId])
}

/// Dedup + audit for payment-provider webhooks (at-least-once delivery, so
/// retries are expected). `processedAt` null + `error` set = needs a retry.
model PaymentWebhookEvent {
  id         String    @id @default(cuid())
  provider   String
  externalId String
  type       String
  action     String?
  payload    Json
  processedAt DateTime?
  error      String?
  createdAt  DateTime  @default(now())

  @@unique([provider, externalId])
  @@index([createdAt])
}

model Feedback {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  type      FeedbackType
  rating    Int?
  message   String
  pageUrl   String?
  status    FeedbackStatus @default(NOVO)
  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

/// Replaces the in-memory Map used in the sibling ArenaHub project — must
/// survive a process restart and work across more than one API instance.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Presskit {
  id       String         @id @default(cuid())
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind PresskitKind @default(ARTIST)
  /// Name shown on the page. Null = the owner's User.name (an artist's own
  /// page); always set on roster pages, whose owner is the agency.
  displayName String?
  /// For an artist page created by an AGENCY: the agency's own presskit.
  agencyId String?
  agency   Presskit?  @relation("AgencyRoster", fields: [agencyId], references: [id], onDelete: SetNull)
  roster   Presskit[] @relation("AgencyRoster")

  slug        String         @unique
  category    ArtistCategory
  templateKey String         @default("default")
  published   Boolean        @default(false)

  /// Header location tag ("São Paulo - SP"), distinct from the CONTACT
  /// section — bio/contact content itself lives in Section.data (BIO and
  /// CONTACT types) so there is exactly one place to edit each, not two.
  city  String?
  state String?

  ogTitleOverride       String?
  ogDescriptionOverride String?

  /// Theme: colors are picked directly (hex); "muted"/"border" tones used by
  /// the renderer are derived from themeTextColor at render time (CSS
  /// color-mix), not stored — one fewer thing for the artist to configure.
  themeBackgroundColor    String  @default("#0a0a0a")
  themeTextColor          String  @default("#fafafa")
  themeAccentColor        String  @default("#f43f5e")
  themeFontKey            String  @default("inter")
  /// Font for headings and the artist name; null = same as themeFontKey.
  themeHeadingFontKey     String?
  /// Corner style of buttons on the public page: SQUARE | ROUNDED | PILL.
  themeButtonStyle        String  @default("ROUNDED")
  themeBackgroundImageUrl String?
  themeBackgroundImageKey String?
  /// Background fine-tuning: darkening overlay 0–90 (%), blur 0–20 (px),
  /// focus point, fixed vs scrolling, tiled pattern, and a CSS preset
  /// (gradient/texture) drawn with the theme colors — see BACKGROUND_PRESETS.
  themeBackgroundOverlay    Int     @default(55)
  themeBackgroundBlur       Int     @default(0)
  themeBackgroundPosition   String  @default("center")
  themeBackgroundAttachment String  @default("FIXED")
  themeBackgroundRepeat     Boolean @default(false)
  themeBackgroundPreset     String  @default("none")

  /// Identity images, each with its storage key so removal can delete the
  /// object. Cover = hero/banner (distinct from the page background),
  /// avatar = round portrait, logo = replaces the artist name as text.
  coverImageUrl  String?
  coverImageKey  String?
  avatarImageUrl String?
  avatarImageKey String?
  logoImageUrl   String?
  logoImageKey   String?

  /// YouTube/Vimeo link rendered muted + looping as the hero background.
  heroVideoUrl String?

  /// WhatsApp floating button: number in international digits (5511…) and
  /// the pre-filled message.
  whatsappNumber  String?
  whatsappMessage String?

  /// Icon row under the header: [{ platform, url, label? }] (QUICK_LINK_PLATFORMS).
  quickLinks Json @default("[]")

  /// Languages the public page offers; "pt" is always present. English
  /// content lives in Section.titleEn / Section.dataEn.
  languages String[] @default(["pt"])

  /// Artist-owned domain pointing at this presskit. PENDING until the
  /// operator confirms the DNS/CNAME is live (ACTIVE); the landing resolves
  /// the request host through GET /public/domains/:host.
  customDomain       String? @unique
  customDomainStatus String  @default("NONE")

  /// Site navigation: SCROLL (one long page with a sticky anchor bar) or
  /// TABS (one section at a time, CSS :target — no JS on the public page).
  navMode String  @default("SCROLL")
  showNav Boolean @default(true)
  /// Short line under the artist name ("DJ de techno · São Paulo").
  tagline String?

  sections       Section[]
  linkClicks     LinkClick[]
  mediaEmbeds    MediaEmbed[]
  galleryPhotos  GalleryPhoto[]
  tourDates      TourDate[]
  pressMentions  PressMention[]
  trackableLinks TrackableLink[]
  pageViews      PageView[]
  slugHistory    SlugHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([agencyId])
}

/// Keeps old slugs redirecting (301) for a period after an artist renames
/// their presskit, so links already shared (including trackable ones) don't
/// break silently.
model SlugHistory {
  id         String   @id @default(cuid())
  presskitId String
  presskit   Presskit @relation(fields: [presskitId], references: [id], onDelete: Cascade)
  oldSlug    String   @unique
  createdAt  DateTime @default(now())
}

/// Ordering/visibility layer for singular blocks (bio, contact, tech rider,
/// custom). Collection-shaped sections (media/gallery/tour dates/press) only
/// use this row to toggle visibility+order — the actual items live in their
/// own tables below, keyed directly by presskitId.
model Section {
  id         String      @id @default(cuid())
  presskitId String
  presskit   Presskit    @relation(fields: [presskitId], references: [id], onDelete: Cascade)
  type       SectionType
  /// Editable display title (falls back to SECTION_DEFAULT_TITLES[type] in
  /// the UI when null) — the section TYPE stays fixed (it determines what
  /// content lives there), only the label the artist sees is customizable.
  title      String?
  order      Int
  visible    Boolean     @default(true)
  data       Json        @default("{}")
  /// English variants (shown when the visitor picks EN). Same shape as
  /// title/data but every field optional — anything missing falls back to
  /// the Portuguese value at render time.
  titleEn    String?
  dataEn     Json?
  /// Per-section look: background (color/image/preset/overlay), text and
  /// accent overrides, width, spacing, alignment — see sectionStyleSchema.
  style      Json        @default("{}")
  /// Per-type layout variant key (SECTION_LAYOUTS in shared); null = default.
  layout     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([presskitId, type])
  @@index([presskitId])
}

/// Clicks on conversion elements of the public page (WhatsApp button,
/// quick links, header actions) — `target` is a short label such as
/// "whatsapp" or "quicklink:SPOTIFY". Counted on the "Quem abriu" screen.
model LinkClick {
  id         String   @id @default(cuid())
  presskitId String
  presskit   Presskit @relation(fields: [presskitId], references: [id], onDelete: Cascade)
  target     String
  sessionId  String?
  createdAt  DateTime @default(now())

  @@index([presskitId, createdAt])
}

model MediaEmbed {
  id         String        @id @default(cuid())
  presskitId String
  presskit   Presskit      @relation(fields: [presskitId], references: [id], onDelete: Cascade)
  provider   MediaProvider
  url        String
  title      String?
  order      Int

  @@index([presskitId])
}

model GalleryPhoto {
  id         String   @id @default(cuid())
  presskitId String
  presskit   Presskit @relation(fields: [presskitId], references: [id], onDelete: Cascade)
  storageKey String
  url        String
  width      Int
  height     Int
  order      Int
  caption    String?

  @@index([presskitId])
}

model TourDate {
  id         String   @id @default(cuid())
  presskitId String
  presskit   Presskit @relation(fields: [presskitId], references: [id], onDelete: Cascade)
  date       DateTime
  venueName  String
  city       String
  ticketUrl  String?

  @@index([presskitId])
}

model PressMention {
  id          String    @id @default(cuid())
  presskitId  String
  presskit    Presskit  @relation(fields: [presskitId], references: [id], onDelete: Cascade)
  outlet      String
  quote       String?
  url         String?
  logoUrl     String?
  publishedAt DateTime?

  @@index([presskitId])
}

model TrackableLink {
  id         String   @id @default(cuid())
  presskitId String
  presskit   Presskit @relation(fields: [presskitId], references: [id], onDelete: Cascade)
  code       String
  label      String
  active     Boolean  @default(true)

  pageViews PageView[]

  createdAt DateTime @default(now())

  @@unique([presskitId, code])
  @@index([presskitId])
}

/// Raw IP is never persisted — it's only used transiently (request-time) to
/// resolve `country`. See PLAN risk notes on LGPD.
model PageView {
  id              String         @id @default(cuid())
  presskitId      String
  presskit        Presskit       @relation(fields: [presskitId], references: [id], onDelete: Cascade)
  trackableLinkId String?
  trackableLink   TrackableLink? @relation(fields: [trackableLinkId], references: [id], onDelete: SetNull)

  sessionId    String
  referrerUrl  String?
  referrerHost String?
  deviceType   String?
  country      String?

  createdAt DateTime @default(now())

  @@index([presskitId, createdAt])
  @@index([presskitId, trackableLinkId])
}


/// One-time 6-digit codes for "esqueci minha senha". Only the hash is
/// stored; the code itself exists in the e-mail and nowhere else. A new
/// request consumes any previous unconsumed code for that user.
model PasswordResetCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([userId, consumedAt])
}
