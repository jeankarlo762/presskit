generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanKey {
  FREE
  PRO
}

/// SUPERADMIN is the platform operator (sees/edits every account); USER is
/// an artist. Deliberately just two values — there is no per-presskit
/// collaborator model yet, so finer roles would be speculation.
enum UserRole {
  USER
  SUPERADMIN
}

enum ArtistCategory {
  MUSICO_BANDA
  DJ
  ATOR
  ARTISTA_VISUAL
}

enum SectionType {
  BIO
  MUSIC
  VIDEO
  GALLERY
  PRESS
  TOUR_DATES
  CONTACT
  TECH_RIDER
  CUSTOM
}

enum MediaProvider {
  SPOTIFY
  YOUTUBE
  SOUNDCLOUD
  VIMEO
}

enum BillingCycle {
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

/// Mirrors Mercado Pago's preapproval statuses (pending / authorized /
/// paused / cancelled). Delinquency is NOT a status here — it's the
/// `pastDue` flag on an AUTHORIZED subscription, because MP keeps the
/// subscription authorized while it retries a failed charge.
enum SubscriptionStatus {
  PENDING
  AUTHORIZED
  PAUSED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  IN_PROCESS
  APPROVED
  REJECTED
  REFUNDED
  CHARGED_BACK
  CANCELLED
}

enum FeedbackType {
  BUG
  SUGESTAO
  ELOGIO
  DUVIDA
  OUTRO
}

enum FeedbackStatus {
  NOVO
  EM_ANALISE
  RESOLVIDO
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  passwordHash String
  name      String
  /// Entitlement, derived from the active subscription by
  /// billing.service syncEntitlement — billing code never edits it any
  /// other way (a superadmin may still override manually).
  planKey   PlanKey  @default(FREE)
  role      UserRole @default(USER)
  lastLoginAt DateTime?

  presskit      Presskit?
  refreshTokens RefreshToken[]
  subscriptions Subscription[]
  payments      Payment[]
  feedbacks     Feedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One row per Mercado Pago preapproval. A user may accumulate several
/// over time (cancel → resubscribe); at most one is AUTHORIZED/PENDING.
model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cycle       BillingCycle
  status      SubscriptionStatus @default(PENDING)
  amountCents Int
  currency    String             @default("BRL")

  mpPreapprovalId String? @unique
  mpPayerId       String?
  mpInitPoint     String?
  /// MP's own status string, kept verbatim for debugging mismatches.
  mpRawStatus     String?

  nextPaymentDate  DateTime?
  currentPeriodEnd DateTime?
  lastChargedAt    DateTime?
  /// Consecutive failed/retrying charges reported by MP; reset on an
  /// approved payment. Drives the "inadimplência" view.
  failedCharges Int     @default(0)
  pastDue       Boolean @default(false)
  cancelledAt   DateTime?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, pastDue])
}

model Payment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  mpPaymentId           String  @unique
  mpAuthorizedPaymentId String?

  status        PaymentStatus
  statusDetail  String?
  amountCents   Int
  currency      String  @default("BRL")
  paymentMethod String?
  paidAt        DateTime?
  payload       Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, createdAt])
  @@index([subscriptionId])
}

/// Dedup + audit for payment-provider webhooks (at-least-once delivery, so
/// retries are expected). `processedAt` null + `error` set = needs a retry.
model PaymentWebhookEvent {
  id         String    @id @default(cuid())
  provider   String
  externalId String
  type       String
  action     String?
  payload    Json
  processedAt DateTime?
  error      String?
  createdAt  DateTime  @default(now())

  @@unique([provider, externalId])
  @@index([createdAt])
}

model Feedback {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  type      FeedbackType
  rating    Int?
  message   String
  pageUrl   String?
  status    FeedbackStatus @default(NOVO)
  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

/// Replaces the in-memory Map used in the sibling ArenaHub project — must
/// survive a process restart and work across more than one API instance.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Presskit {
  id       String         @id @default(cuid())
  userId   String         @unique
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  slug        String         @unique
  category    ArtistCategory
  templateKey String         @default("default")
  published   Boolean        @default(false)

  /// Header location tag ("São Paulo - SP"), distinct from the CONTACT
  /// section — bio/contact content itself lives in Section.data (BIO and
  /// CONTACT types) so there is exactly one place to edit each, not two.
  city  String?
  state String?

  ogTitleOverride       String?
  ogDescriptionOverride String?

  /// Theme: colors are picked directly (hex); "muted"/"border" tones used by
  /// the renderer are derived from themeTextColor at render time (CSS
  /// color-mix), not stored — one fewer thing for the artist to configure.
  themeBackgroundColor    String  @default("#0a0a0a")
  themeTextColor          String  @default("#fafafa")
  themeAccentColor        String  @default("#f43f5e")
  themeFontKey            String  @default("inter")
  themeBackgroundImageUrl String?
  themeBackgroundImageKey String?

  sections       Section[]
  mediaEmbeds    MediaEmbed[]
  galleryPhotos  GalleryPhoto[]
  tourDates      TourDate[]
  pressMentions  PressMention[]
  trackableLinks TrackableLink[]
  pageViews      PageView[]
  slugHistory    SlugHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Keeps old slugs redirecting (301) for a period after an artist renames
/// their presskit, so links already shared (including trackable ones) don't
/// break silently.
model SlugHistory {
  id         String   @id @default(cuid())
  presskitId String
  presskit   Presskit @relation(fields: [presskitId], references: [id], onDelete: Cascade)
  oldSlug    String   @unique
  createdAt  DateTime @default(now())
}

/// Ordering/visibility layer for singular blocks (bio, contact, tech rider,
/// custom). Collection-shaped sections (media/gallery/tour dates/press) only
/// use this row to toggle visibility+order — the actual items live in their
/// own tables below, keyed directly by presskitId.
model Section {
  id         String      @id @default(cuid())
  presskitId String
  presskit   Presskit    @relation(fields: [presskitId], references: [id], onDelete: Cascade)
  type       SectionType
  /// Editable display title (falls back to SECTION_DEFAULT_TITLES[type] in
  /// the UI when null) — the section TYPE stays fixed (it determines what
  /// content lives there), only the label the artist sees is customizable.
  title      String?
  order      Int
  visible    Boolean     @default(true)
  data       Json        @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([presskitId, type])
  @@index([presskitId])
}

model MediaEmbed {
  id         String        @id @default(cuid())
  presskitId String
  presskit   Presskit      @relation(fields: [presskitId], references: [id], onDelete: Cascade)
  provider   MediaProvider
  url        String
  title      String?
  order      Int

  @@index([presskitId])
}

model GalleryPhoto {
  id         String   @id @default(cuid())
  presskitId String
  presskit   Presskit @relation(fields: [presskitId], references: [id], onDelete: Cascade)
  storageKey String
  url        String
  width      Int
  height     Int
  order      Int
  caption    String?

  @@index([presskitId])
}

model TourDate {
  id         String   @id @default(cuid())
  presskitId String
  presskit   Presskit @relation(fields: [presskitId], references: [id], onDelete: Cascade)
  date       DateTime
  venueName  String
  city       String
  ticketUrl  String?

  @@index([presskitId])
}

model PressMention {
  id          String    @id @default(cuid())
  presskitId  String
  presskit    Presskit  @relation(fields: [presskitId], references: [id], onDelete: Cascade)
  outlet      String
  quote       String?
  url         String?
  logoUrl     String?
  publishedAt DateTime?

  @@index([presskitId])
}

model TrackableLink {
  id         String   @id @default(cuid())
  presskitId String
  presskit   Presskit @relation(fields: [presskitId], references: [id], onDelete: Cascade)
  code       String
  label      String
  active     Boolean  @default(true)

  pageViews PageView[]

  createdAt DateTime @default(now())

  @@unique([presskitId, code])
  @@index([presskitId])
}

/// Raw IP is never persisted — it's only used transiently (request-time) to
/// resolve `country`. See PLAN risk notes on LGPD.
model PageView {
  id              String         @id @default(cuid())
  presskitId      String
  presskit        Presskit       @relation(fields: [presskitId], references: [id], onDelete: Cascade)
  trackableLinkId String?
  trackableLink   TrackableLink? @relation(fields: [trackableLinkId], references: [id], onDelete: SetNull)

  sessionId    String
  referrerUrl  String?
  referrerHost String?
  deviceType   String?
  country      String?

  createdAt DateTime @default(now())

  @@index([presskitId, createdAt])
  @@index([presskitId, trackableLinkId])
}

