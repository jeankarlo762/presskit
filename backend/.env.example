# Requer PostgreSQL (schema.prisma usa provider = "postgresql")
DATABASE_URL="postgresql://user:password@localhost:5432/presskit?schema=public"

NODE_ENV=development
PORT=3333

# gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# obrigatório em produção — lista separada por vírgula
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cloudflare R2 (armazenamento de mídia — galeria de fotos e fundo do tema)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=presskit-media
R2_PUBLIC_BASE_URL=

# Dev local sem conta R2 real: rode `npm run dev:storage --workspace=@presskit/api`
# (sobe um servidor S3-compatível local) e preencha assim:
#   STORAGE_ENDPOINT=http://localhost:4568
#   STORAGE_FORCE_PATH_STYLE=true
#   R2_ACCESS_KEY_ID=dev
#   R2_SECRET_ACCESS_KEY=dev
#   R2_BUCKET=presskit-media
#   R2_PUBLIC_BASE_URL=http://localhost:4568/presskit-media
# Em produção, deixe as duas linhas abaixo vazias/ausentes — R2 real usa o
# endpoint derivado de R2_ACCOUNT_ID.
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false

# Asaas (Pix/cartão) — sandbox por padrão
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
