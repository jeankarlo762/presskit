# Requer PostgreSQL (schema.prisma usa provider = "postgresql")
DATABASE_URL="postgresql://user:password@localhost:5432/presskit?schema=public"

NODE_ENV=development
PORT=3333

# gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# obrigatório em produção — lista separada por vírgula
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# E-mails promovidos a SUPERADMIN no próximo login/cadastro (separados por
# vírgula). Forma de criar o primeiro operador em um deploy novo.
SUPERADMIN_EMAILS=

# URL pública do painel (frontend) — destino do retorno do checkout.
PUBLIC_DASHBOARD_URL=http://localhost:5173

# Cloudflare R2 (armazenamento de mídia — galeria de fotos e fundo do tema)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=presskit-media
R2_PUBLIC_BASE_URL=

# Dev local sem conta R2 real: rode `npm run dev:storage --workspace=@presskit/api`
# (sobe um servidor S3-compatível local) e preencha assim:
#   STORAGE_ENDPOINT=http://localhost:4568
#   STORAGE_FORCE_PATH_STYLE=true
#   R2_ACCESS_KEY_ID=S3RVER
#   R2_SECRET_ACCESS_KEY=S3RVER
#   R2_BUCKET=presskit-media
#   R2_PUBLIC_BASE_URL=http://localhost:4568/presskit-media
# Em produção, deixe as duas linhas abaixo vazias/ausentes — R2 real usa o
# endpoint derivado de R2_ACCOUNT_ID.
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false

# E-mail transacional (código de "esqueci minha senha"). Escolha UM:
#  a) Resend (https://resend.com — domínio verificado + API key):
RESEND_API_KEY=
#  b) SMTP genérico (Gmail/Workspace com senha de app, SES, Brevo...):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remetente exibido nos e-mails (precisa ser um domínio autorizado no provedor)
EMAIL_FROM="PressKit.AI <no-reply@presskitai.com.br>"
# Sem nenhum dos dois, em desenvolvimento o código é impresso no console.

# Mercado Pago — assinaturas recorrentes (Preapproval). Use o access token de
# TESTE enquanto estiver homologando; troque pelo de produção depois.
# Painel: https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=
# "Suas integrações > Webhooks > Configurar notificações": URL
#   https://<api>/webhooks/mercadopago  com os tópicos
#   payment, subscription_preapproval, subscription_authorized_payment.
# A chave secreta gerada ali vai aqui:
MERCADOPAGO_WEBHOOK_SECRET=

# Login com Google: OAuth client ID (Google Cloud Console > Credenciais,
# tipo "Aplicativo da Web"). Vazio = botão do Google desativado.
GOOGLE_CLIENT_ID=
