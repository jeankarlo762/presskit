# Requer PostgreSQL (schema.prisma usa provider = "postgresql")
DATABASE_URL="postgresql://user:password@localhost:5432/presskit?schema=public"

NODE_ENV=development
PORT=3333

# gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# obrigatório em produção — lista separada por vírgula
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cloudflare R2 (armazenamento de mídia — galeria de fotos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=presskit-media
R2_PUBLIC_BASE_URL=

# Asaas (Pix/cartão) — sandbox por padrão
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
